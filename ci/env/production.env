# Production configuration (non-secret). Secrets come from the Jenkins
# credential "ontrack-prod-secrets" - see secrets.example.env.
RAILS_ENV=production
HTTP_PORT=80
API_MEM_LIMIT=2g
DB_NAME=doubtfire_production
DB_USER=dfire

DF_INSTITUTION_HOST=http://localhost
DF_INSTITUTION_PRODUCT_NAME=OnTrack
DF_INSTITUTION_NAME=Thoth Tech
DF_AUTH_METHOD=database
DF_STUDENT_WORK_DIR=/student-work
DF_REDIS_SIDEKIQ_URL=redis://redis:6379/0
DF_MAIL_PERFORM_DELIVERIES=no
DF_MAX_PDF_GEN_PROCESSES=2
OVERSEER_ENABLED=0
RAILS_LOG_TO_STDOUT=true
